+static struct file *ksu_open_file_from_init_root(const char *path)
+{
+    struct task_struct *pid1_task;
+    struct pid *pid_struct;
+    struct path init_root;
+    struct file *file;
+    const struct cred *old_cred;
+
+    rcu_read_lock();
+    pid_struct = find_pid_ns(1, &init_pid_ns);
+    pid1_task = pid_struct ? get_pid_task(pid_struct, PIDTYPE_PID) : NULL;
+    rcu_read_unlock();
+    if (!pid1_task)
+        return ERR_PTR(-ESRCH);
+
+    get_fs_root(pid1_task->fs, &init_root);
+    put_task_struct(pid1_task);
+
+    old_cred = override_creds(ksu_cred);
+    file = file_open_root(&init_root, path, O_PATH, 0);
+    revert_creds(old_cred);
+    path_put(&init_root);
+
+    return file;
+}
