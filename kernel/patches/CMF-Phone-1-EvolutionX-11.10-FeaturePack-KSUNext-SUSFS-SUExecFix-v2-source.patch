+++ b/net/ipv4/sysctl_net_ipv4.c
@@ -19,6 +19,9 @@
 #include <net/ping.h>
 #include <net/protocol.h>
 #include <net/netevent.h>
+#ifndef __GENKSYMS__
+#include <net/netns/generic.h>
+#endif
 
