+	std::string booted_slot = android::base::GetProperty("ro.boot.slot_suffix", "");
+	if (booted_slot.empty())
+		booted_slot = android::base::GetProperty("ro.boot.slot", "");
+
+	std::string booted_slot_display;
+	if (booted_slot == "_a" || booted_slot == "a")
+		booted_slot_display = "A";
+	else if (booted_slot == "_b" || booted_slot == "b")
+		booted_slot_display = "B";
+	else {
+		LOGERR("Cannot safely determine the booted slot for vendor_boot recovery injection\n");
+		return false;
+	}
+
+	const std::string target_slot = booted_slot_display == "A" ? "B" : "A";
+	std::string previous_selected_slot = PartitionManager.Get_Active_Slot_Display();
+	if (previous_selected_slot != "A" && previous_selected_slot != "B")
+		previous_selected_slot = booted_slot_display;
+
+	LOGINFO("Safe vendor_boot recovery injection: booted slot %s, target slot %s\n",
+		booted_slot_display.c_str(), target_slot.c_str());
+	PartitionManager.Override_Active_Slot(target_slot);
+
+	auto restore_selected_slot = [&]() {
+		if (PartitionManager.Get_Active_Slot_Display() != previous_selected_slot)
+			PartitionManager.Override_Active_Slot(previous_selected_slot);
+	};
