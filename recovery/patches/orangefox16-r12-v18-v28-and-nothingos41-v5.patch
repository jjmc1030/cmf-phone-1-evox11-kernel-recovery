+	TWPartition* target_part = PartitionManager.Find_Partition_By_Path("/vendor_boot");
+	const std::string expected_suffix = target_slot == "A" ? "_a" : "_b";
+	if (!target_part || !target_part->Is_SlotSelect() ||
+	    target_part->Actual_Block_Device.size() < expected_suffix.size() ||
+	    target_part->Actual_Block_Device.compare(
+		target_part->Actual_Block_Device.size() - expected_suffix.size(),
+		expected_suffix.size(), expected_suffix) != 0) {
