index ecc586df..1dfb1c6c 100644
--- a/orangefox.mk
+++ b/orangefox.mk
@@ -567,6 +567,12 @@ else
     LOCAL_CFLAGS += -DOF_DEFAULT_TIMEZONE='"CET-1;CEST,M3.5.0,M10.5.0"'
 endif
 
+# Some devices keep OrangeFox settings outside userdata. Allow the device tree
+# to override a stale saved timezone on every recovery boot.
+ifneq ($(OF_FORCE_TIMEZONE),)
+    LOCAL_CFLAGS += -DOF_FORCE_TIMEZONE='"$(OF_FORCE_TIMEZONE)"'
+endif
+
 # support fs compression (requires kernel support and appropriate fstab flags)
 ifeq ($(TW_ENABLE_FS_COMPRESSION),true)
   OF_ENABLE_FS_COMPRESSION := 1
