+# HOME
+HOME=$(getprop "ro.orangefox.home")
+[ -z "$HOME" ] && HOME=/sdcard/Fox
+[ ! -d $HOME ] && mkdir -p -m 0777 $HOME
+[ ! -d $HOME ] && HOME=/tmp
+export HOME
 
 # shell
 export PS1='\s-\v \w > '
@@ -15,6 +40,8 @@ alias del="rm -i"
