@@ -971,6 +977,13 @@ local upx_bin=$FOX_VENDOR_PATH/tools/upx;
 			bins=$(ls ./);
 			for i in $bins
 			do
+				# PID 1 re-executes itself after entering the vendor_init
+				# SELinux domain. UPX needs execmem while unpacking, which that
+				# domain intentionally denies. Symlinks such as ueventd and
