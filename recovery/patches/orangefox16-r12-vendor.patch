 alias copy="cp -i"
 alias diskfree="df -Ph"
+alias path="echo $PATH"
+alias ver="echo -n 'OrangeFox ' && echo -n '- ' && echo -n $(getprop ro.orangefox.type) && echo -n ' - ' && getprop ro.orangefox.release.version && cat /proc/version"
