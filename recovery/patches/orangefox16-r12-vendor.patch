+}
+
+Reset_Settings() {
+local FOX_HOME=$($GETPROP "ro.orangefox.home")
+local FOX_SETTINGS=$($GETPROP "ro.orangefox.settings")
+	[ -z "$FOX_HOME" ] && FOX_HOME=/sdcard/Fox
+	[ -z "$FOX_SETTINGS" ] && FOX_SETTINGS=/sdcard/Fox
+
+	ui_print "- Removing any old OrangeFox configuration files ..."
+	rm -rf $FOX_HOME/.bin.
+	rm -f $FOX_HOME/.bash*
+	rm -f $FOX_HOME/fox*
+	rm -f $FOX_HOME/aromafm.cfg
+	rm -rf $FOX_SETTINGS/.theme
+	rm -rf $FOX_SETTINGS/.navbar
+	rm -f $FOX_SETTINGS/.fox*
+
 	if [ "$PERSIST_PATH" != "ERROR" -a -d $PERSIST_PATH ]; then
 	   	[ "$BOOTMODE" != "true" ] && mount_part $PERSIST_PATH
 	   	rm -f $PERSIST_PATH/.fsec*
@@ -841,6 +861,33 @@ local F="$1"
 	else
 		[ "$PERSIST_PATH" = "ERROR" ] && ui_print "- Some old settings might remain."
 	fi
+
+	# remove any lingering legacy settings
+	Legacy_Reset_Settings;
+
+	# other contingencies (eg, installing with R11, or with another recovery)
+	local F=""
+	if [ -n "$FOX_SETTINGS_ROOT_DIRECTORY" ]; then
+		F=$FOX_SETTINGS_ROOT_DIRECTORY"/Fox"
+		if [ "$F" != "$FOX_SETTINGS" ]; then
+			FOX_SETTINGS=$F
+			rm -rf $FOX_SETTINGS/.theme
+			rm -rf $FOX_SETTINGS/.navbar
+			rm -f $FOX_SETTINGS/.fox*
+		fi
+	fi
+
+	if [ -n "$FOX_MISCELLANEOUS_ROOT_DIRECTORY" ]; then
+		F=$FOX_MISCELLANEOUS_ROOT_DIRECTORY"/Fox"
+		if [ "$F" != "$FOX_HOME" ]; then
+			FOX_HOME=$F
+			rm -rf $FOX_HOME/.bin.
+			rm -f $FOX_HOME/.bash*
+			rm -f $FOX_HOME/fox*
+			rm -f $FOX_HOME/aromafm.cfg
+		fi
+	fi
+	#
 }
 
